// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  HAIRDRESSER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id         String  @id @default(uuid()) @db.Uuid
  email      String
  firstName  String
  lastName   String
  phone      String
  photoUrl   String?
  role       Role
  isApproved Boolean @default(false)

  schedules               Schedule[]    @relation("HairdresserSchedules")
  clientAppointments      Appointment[] @relation("ClientAppointments")
  hairdresserAppointments Appointment[] @relation("HairdresserAppointments")
}

model Schedule {
  id            String   @id @default(uuid()) @db.Uuid
  hairdresserId String   @db.Uuid
  date          DateTime @db.Date
  startTime     Int
  endTime       Int

  hairdresser User @relation("HairdresserSchedules", fields: [hairdresserId], references: [id], onDelete: Cascade)

  @@index([hairdresserId, date])
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  clientId      String            @db.Uuid
  hairdresserId String            @db.Uuid
  date          DateTime          @db.Date
  startTime     Int
  duration      Int
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  client      User @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  hairdresser User @relation("HairdresserAppointments", fields: [hairdresserId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@index([hairdresserId, date, startTime])
}

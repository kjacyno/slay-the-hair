// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  CLIENT
  STYLIST
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  userId       String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  firstName    String
  lastName     String
  phone        String
  photoUrl     String?
  role         Role
  isApproved   Boolean       @default(false)

  schedules                Schedule[]    @relation("StylistSchedules")
  clientAppointments       Appointment[] @relation("ClientAppointments")
  stylistAppointments      Appointment[] @relation("StylistAppointments")
}

model Schedule {
  id            String   @id @default(uuid()) @db.Uuid
  stylistId     String   @db.Uuid
  date          DateTime @db.Date
  startTime     Int
  endTime       Int

  stylist User @relation("StylistSchedules", fields: [stylistId], references: [userId], onDelete: Cascade)

  @@index([stylistId, date])
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  clientId      String            @db.Uuid
  stylistId     String            @db.Uuid
  date          DateTime          @db.Date
  startTime     Int
  duration      Int
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  client      User @relation("ClientAppointments", fields: [clientId], references: [userId], onDelete: Cascade)
  stylist     User @relation("StylistAppointments", fields: [stylistId], references: [userId], onDelete: Cascade)

  @@index([clientId, date])
  @@index([stylistId, date, startTime])
}
